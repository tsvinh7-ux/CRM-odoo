<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kết nối minh hoạ (chưa có khoá thật). Sự kiện bên dưới mô phỏng webhook để xem dòng thời gian. -->
    <record id="demo_account_facebook" model="dmag.channel.account">
        <field name="name">Fanpage DMAG (demo)</field>
        <field name="channel">facebook</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>
    <record id="demo_account_zalo" model="dmag.channel.account">
        <field name="name">Zalo OA DMAG (demo)</field>
        <field name="channel">zalo</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>
    <record id="demo_account_stringee" model="dmag.channel.account">
        <field name="name">Hotline DMAG (demo)</field>
        <field name="channel">stringee</field>
        <field name="stringee_hotline">842471000000</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>

    <!-- Facebook: khách nhắn kèm SĐT trùng phòng khám Ánh Dương → tin nhắn vào đúng lead đang mở -->
    <function model="dmag.channel.event" name="_dmag_receive" eval="[ref('demo_account_facebook'), {
        'object': 'page',
        'entry': [{'id': 'PAGE1', 'time': int(time.time() * 1000), 'messaging': [
            {'sender': {'id': 'PSID-1001'}, 'recipient': {'id': 'PAGE1'}, 'timestamp': int(time.time() * 1000) - 600000,
             'message': {'mid': 'm_demo_1', 'text': 'Chào DMAG, phòng khám mình muốn đăng ký kiểm toán DDA. SĐT 0901 000 111'}},
            {'sender': {'id': 'PAGE1'}, 'recipient': {'id': 'PSID-1001'}, 'timestamp': int(time.time() * 1000) - 300000,
             'message': {'mid': 'm_demo_2', 'is_echo': True, 'text': 'Dạ DMAG đã nhận, chuyên viên sẽ gọi lại anh/chị trong 15 phút ạ.'}}
        ]}]}]"/>

    <!-- Zalo: người mới quan tâm OA và hỏi → tạo liên hệ + lead mới ở P1 -->
    <function model="dmag.channel.event" name="_dmag_receive" eval="[ref('demo_account_zalo'), {
        'app_id': 'APP', 'event_name': 'follow', 'timestamp': str(int(time.time() * 1000) - 900000),
        'follower': {'id': 'ZU-2002'}}]"/>
    <function model="dmag.channel.event" name="_dmag_receive" eval="[ref('demo_account_zalo'), {
        'app_id': 'APP', 'event_name': 'user_send_text', 'timestamp': str(int(time.time() * 1000) - 800000),
        'sender': {'id': 'ZU-2002'}, 'recipient': {'id': 'OA1'},
        'message': {'msg_id': 'z_demo_1', 'text': 'Cho em hỏi lịch hội thảo vùng ở Hải Phòng tháng tới ạ?'}}]"/>

    <!-- Stringee: phòng khám Cát Tường gọi vào, nghe máy 3 phút 25 giây, có ghi âm -->
    <function model="dmag.channel.event" name="_dmag_receive" eval="[ref('demo_account_stringee'), {
        'call_id': 'call-demo-1', 'call_status': 'ringing', 'from': {'number': '84903000333', 'type': 'external'},
        'to': {'number': '842471000000', 'type': 'external'}, 'timestamp_ms': int(time.time() * 1000) - 400000}]"/>
    <function model="dmag.channel.event" name="_dmag_receive" eval="[ref('demo_account_stringee'), {
        'call_id': 'call-demo-1', 'call_status': 'answered', 'timestamp_ms': int(time.time() * 1000) - 390000}]"/>
    <function model="dmag.channel.event" name="_dmag_receive" eval="[ref('demo_account_stringee'), {
        'call_id': 'call-demo-1', 'call_status': 'ended', 'duration': 205, 'timestamp_ms': int(time.time() * 1000) - 185000,
        'recording_url': 'https://example.com/demo-recording.mp3'}]"/>
    <!-- Một cuộc gọi nhỡ → tự giao việc "Gọi lại" -->
    <function model="dmag.channel.event" name="_dmag_receive" eval="[ref('demo_account_stringee'), {
        'call_id': 'call-demo-2', 'call_status': 'ended', 'from': {'number': '84903000333', 'type': 'external'},
        'to': {'number': '842471000000', 'type': 'external'}, 'timestamp_ms': int(time.time() * 1000) - 60000}]"/>
</odoo>
