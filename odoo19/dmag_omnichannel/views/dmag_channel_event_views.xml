<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dmag_channel_event_view_list" model="ir.ui.view">
        <field name="name">dmag.channel.event.list</field>
        <field name="model">dmag.channel.event</field>
        <field name="arch" type="xml">
            <list string="Nhật ký webhook" create="false" decoration-danger="state == 'error'">
                <field name="create_date"/>
                <field name="account_id"/>
                <field name="channel"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'error'"/>
                <field name="attempts"/>
                <field name="error" optional="show"/>
                <button name="action_retry" type="object" icon="fa-refresh" title="Xử lý lại" invisible="state != 'error'"/>
            </list>
        </field>
    </record>

    <record id="dmag_channel_event_view_form" model="ir.ui.view">
        <field name="name">dmag.channel.event.form</field>
        <field name="model">dmag.channel.event</field>
        <field name="arch" type="xml">
            <form string="Sự kiện webhook" create="false" edit="false">
                <header>
                    <button name="action_retry" type="object" string="Xử lý lại" invisible="state != 'error'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="account_id"/>
                        <field name="create_date"/>
                        <field name="processed_date"/>
                        <field name="attempts"/>
                        <field name="error"/>
                    </group>
                    <field name="payload" widget="ace" options="{'mode': 'json'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dmag_channel_event" model="ir.actions.act_window">
        <field name="name">Nhật ký webhook</field>
        <field name="res_model">dmag.channel.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
