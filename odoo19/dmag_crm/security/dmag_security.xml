<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_dmag" model="res.groups.privilege">
        <field name="name">DMAG</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_dmag_user" model="res.groups">
        <field name="name">Nhân viên</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dmag"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_dmag_manager" model="res.groups">
        <field name="name">Quản lý</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dmag"/>
        <field name="implied_ids" eval="[(4, ref('group_dmag_user')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
