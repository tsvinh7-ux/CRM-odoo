<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_stage_form_dmag" model="ir.ui.view">
        <field name="name">crm.stage.form.dmag</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_count']/.." position="after">
                <group string="Cổng giai đoạn DMAG">
                    <field name="dmag_required_field_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
