    <!-- Hồ sơ DDA minh hoạ cho phòng khám PK3 (điểm giả định) -->
    <record id="demo_audit_a" model="dmag.dda.audit">
        <field name="partner_id" ref="dmag_crm.demo_clinic_a"/>
        <field name="lead_id" ref="dmag_crm.demo_lead_a"/>
        <field name="state">review</field>
        <field name="date_onsite" eval="(DateTime.today() - relativedelta(days=10)).strftime('%Y-%m-%d')"/>
        <field name="conclusion">&lt;p&gt;Phòng khám có nền lâm sàng tốt nhưng chủ còn ngồi ghế quá nhiều, COGS cao, chưa có CRM Recall.&lt;/p&gt;</field>
    </record>
    <function model="dmag.dda.audit" name="_dmag_demo_fill"
              eval="[[ref('demo_audit_a')], [10, 7, 6, 7, 8, 7.5, 7, 6, 5, 7], [10, 7, 4, 6, 6, 7, 6, 3.5, 1.5, 6]]"/>
    <function model="dmag.dda.audit" name="action_approve" eval="[[ref('demo_audit_a')]]"/>
    <function model="dmag.dda.audit" name="action_create_prescription" eval="[[ref('demo_audit_a')]]"/>

    <!-- Phòng khám PK1 có cờ đỏ T1 -->
    <record id="demo_audit_b" model="dmag.dda.audit">
        <field name="partner_id" ref="dmag_crm.demo_clinic_b"/>
        <field name="state">review</field>
        <field name="date_onsite" eval="(DateTime.today() - relativedelta(days=5)).strftime('%Y-%m-%d')"/>
    </record>
    <function model="dmag.dda.audit" name="_dmag_demo_fill"
              eval="[[ref('demo_audit_b')], [9, 6, 6, 5, 6, 6, 5, 5, 4, 5], [6, 3, 2.5, 3, 4, 3.5, 3, 2.5, 1.5, 3]]"/>
    <function model="dmag.dda.audit" name="action_approve" eval="[[ref('demo_audit_b')]]"/>
