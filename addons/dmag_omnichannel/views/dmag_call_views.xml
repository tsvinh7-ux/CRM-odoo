<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dmag_call_view_list" model="ir.ui.view">
        <field name="name">dmag.call.list</field>
        <field name="model">dmag.call</field>
        <field name="arch" type="xml">
            <list string="Cuộc gọi" create="false" decoration-danger="state == 'missed'" decoration-muted="state in ('no_answer', 'busy', 'failed')">
                <field name="date_start"/>
                <field name="direction" widget="badge"/>
                <field name="customer_number"/>
                <field name="partner_id" optional="show"/>
                <field name="lead_id" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'missed'"/>
                <field name="duration_display" string="Thời lượng"/>
                <field name="recording_url" widget="url" optional="show"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dmag_call_view_form" model="ir.ui.view">
        <field name="name">dmag.call.form</field>
        <field name="model">dmag.call</field>
        <field name="arch" type="xml">
            <form string="Cuộc gọi" create="false">
                <header>
                    <button name="action_open_lead" type="object" string="Mở lead" invisible="not lead_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="ringing,answered,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="direction" readonly="1"/>
                            <field name="from_number" readonly="1"/>
                            <field name="to_number" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="1"/>
                            <field name="date_answer" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                            <field name="duration_display"/>
                            <field name="recording_url" widget="url"/>
                            <field name="external_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Ghi chú nội dung cuộc gọi…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dmag_call_view_search" model="ir.ui.view">
        <field name="name">dmag.call.search</field>
        <field name="model">dmag.call</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_number"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter string="Gọi nhỡ" name="missed" domain="[('state', '=', 'missed')]"/>
                <filter string="Của tôi" name="mine" domain="[('user_id', '=', uid)]"/>
                <filter string="Thời gian gọi" name="date_start" date="date_start"/>
                <group>
                    <filter string="Nhân viên" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Trạng thái" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dmag_call" model="ir.actions.act_window">
        <field name="name">Cuộc gọi</field>
        <field name="res_model">dmag.call</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>
</odoo>
