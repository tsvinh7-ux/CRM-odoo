<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_dmag_commission" model="ir.ui.view">
        <field name="name">product.template.form.dmag.commission</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="dmag_dda.product_template_form_dmag"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='dmag_is_dda_deposit']" position="after">
                <field name="dmag_commission_group"/>
            </xpath>
        </field>
    </record>
</odoo>
