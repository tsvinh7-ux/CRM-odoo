<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_dmag_commission" model="ir.ui.view">
        <field name="name">res.company.form.dmag.commission</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Hoa hồng DMAG" name="dmag_commission">
                    <group>
                        <group string="Chia hoa hồng trên mỗi khoản thu">
                            <field name="dmag_split_closer"/>
                            <field name="dmag_split_lead"/>
                            <field name="dmag_split_owner"/>
                        </group>
                        <group string="Đồng bộ lương">
                            <field name="dmag_payroll_code"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
