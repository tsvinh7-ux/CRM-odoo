<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_dmag_delivery" model="ir.ui.view">
        <field name="name">res.partner.form.dmag.delivery</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dmag_view_delivery_plans" type="object" class="oe_stat_button" icon="fa-road"
                        invisible="not dmag_delivery_plan_count">
                    <field name="dmag_delivery_plan_count" widget="statinfo" string="Lộ trình"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='dmag_lifecycle']" position="after">
                <field name="dmag_pulse" widget="badge" invisible="not dmag_pulse"
                       decoration-success="dmag_pulse == 'green'" decoration-warning="dmag_pulse == 'yellow'" decoration-danger="dmag_pulse == 'red'"/>
            </xpath>
        </field>
    </record>
</odoo>
