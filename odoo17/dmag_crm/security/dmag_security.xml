<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dmag" model="ir.module.category">
        <field name="name">DMAG</field>
        <field name="sequence">5</field>
    </record>

    <record id="group_dmag_user" model="res.groups">
        <field name="name">Nhân viên</field>
        <field name="category_id" ref="module_category_dmag"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_dmag_manager" model="res.groups">
        <field name="name">Quản lý</field>
        <field name="category_id" ref="module_category_dmag"/>
        <field name="implied_ids" eval="[(4, ref('group_dmag_user')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
