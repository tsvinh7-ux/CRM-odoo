<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dmag_commission_generate_view_form" model="ir.ui.view">
        <field name="name">dmag.commission.generate.form</field>
        <field name="model">dmag.commission.generate</field>
        <field name="arch" type="xml">
            <form string="Tạo bảng kê hoa hồng tháng">
                <group>
                    <field name="month"/>
                </group>
                <p class="text-muted">Gom mọi dòng hoa hồng chưa vào bảng kê trong tháng thành một bảng kê cho từng nhân sự.</p>
                <footer>
                    <button name="action_generate" type="object" string="Tạo bảng kê" class="btn-primary"/>
                    <button string="Huỷ" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dmag_commission_generate" model="ir.actions.act_window">
        <field name="name">Tạo bảng kê tháng</field>
        <field name="res_model">dmag.commission.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
