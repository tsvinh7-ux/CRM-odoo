<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_dmag_channel_retry" model="ir.cron">
            <field name="name">DMAG: Xử lý lại webhook lỗi</field>
            <field name="model_id" ref="model_dmag_channel_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="numbercall">-1</field>
            <field name="interval_type">minutes</field>
        </record>
        <record id="ir_cron_dmag_zalo_token" model="ir.cron">
            <field name="name">DMAG: Làm mới token Zalo OA</field>
            <field name="model_id" ref="model_dmag_channel_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_zalo_tokens()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="numbercall">-1</field>
            <field name="interval_type">hours</field>
        </record>
    </data>
</odoo>
